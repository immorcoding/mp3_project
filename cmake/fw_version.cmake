# 固件版本头生成脚本：以 cmake -P 在每次构建时运行（由根 CMakeLists.txt 的自定义目标调用）。
#
# 输入变量：
#   SOURCE_DIR  工程根目录（git 命令的工作目录）
#   OUTPUT      生成头的路径
#   BUILD_TYPE  构建类型（Debug / Release 等）
#
# 版本号取 `git describe --always --dirty`；无 git 或不在仓库内时为 "unknown"。
# 生成内容与已有文件相同时不覆盖，使版本不变的增量构建不会触发重编。

find_package(Git QUIET)

set(FW_VERSION "unknown")
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} describe --always --dirty
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE GIT_DESCRIBE
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE GIT_RESULT
    )
    if(GIT_RESULT EQUAL 0 AND NOT GIT_DESCRIBE STREQUAL "")
        set(FW_VERSION "${GIT_DESCRIBE}")
    endif()
endif()

set(CONTENT
"/* Generated by cmake/fw_version.cmake on every build. Do not edit or commit. */
#ifndef FW_VERSION_H
#define FW_VERSION_H

#define FW_VERSION_STRING \"${FW_VERSION}\"
#define FW_BUILD_TYPE_STRING \"${BUILD_TYPE}\"

#endif /* FW_VERSION_H */
")

set(OLD_CONTENT "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" OLD_CONTENT)
endif()

if(NOT OLD_CONTENT STREQUAL CONTENT)
    get_filename_component(OUTPUT_DIR "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${OUTPUT_DIR}")
    file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
